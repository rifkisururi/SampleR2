@{
    ViewData["Title"] = "Produk (PostgreSQL)";
    var produkLocal = (List<ProdukLocalStorage>)ViewBag.ProdukLocal;
    var produkR2 = (List<ProdukR2>)ViewBag.ProdukR2;
    var r2Configured = (bool)ViewBag.R2Configured;
    var saved = ViewBag.Saved as string;
    var deleted = Context.Request.Query["deleted"].ToString();
}

<style>
    .thumb {
        height: 48px;
        width: 48px;
        object-fit: cover;
        border-radius: .25rem;
        border: 1px solid #dee2e6;
        background: #f8f9fa;
    }

    .dropzone {
        border: 2px dashed #adb5bd;
        border-radius: .5rem;
        padding: 1.5rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: border-color .15s ease-in-out, background-color .15s ease-in-out;
    }

    .dropzone:hover, .dropzone:focus-visible {
        border-color: #0d6efd;
        outline: none;
    }

    .dropzone.dragover {
        border-color: #0d6efd;
        background-color: #f0f6ff;
    }

    .preview-img {
        max-height: 160px;
        max-width: 100%;
        border-radius: .375rem;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-11">
        <h1 class="h3 mb-1">📦 Produk (PostgreSQL)</h1>
        <p class="text-muted mb-4">
            Skenario input produk: data produk disimpan di PostgreSQL (Neon), gambarnya bisa disimpan
            ke <strong>local storage</strong> (tabel <code>produk_local</code>) atau langsung ke
            <strong>Cloudflare R2</strong> dari browser (tabel <code>produk_r2</code>).
        </p>

        @if (saved == "local")
        {
            <div class="alert alert-success">✅ Produk tersimpan — gambar di <strong>local storage</strong> (tabel <code>produk_local</code>).</div>
        }
        else if (saved == "r2")
        {
            <div class="alert alert-success">✅ Produk tersimpan — gambar di <strong>Cloudflare R2</strong> (tabel <code>produk_r2</code>).</div>
        }
        else if (deleted == "local")
        {
            <div class="alert alert-success">🗑️ Produk dihapus — row database dan file gambar di local storage sudah dibersihkan.</div>
        }
        else if (deleted == "r2")
        {
            <div class="alert alert-success">🗑️ Produk dihapus — row database dan object gambar di R2 sudah dibersihkan.</div>
        }

        <div class="row g-4 mb-2">
            <!-- ==================== Form 1: local storage ==================== -->
            <div class="col-lg-6">
                <form asp-action="Local" method="post" enctype="multipart/form-data" class="card shadow-sm h-100">
                    @Html.AntiForgeryToken()
                    <div class="card-header bg-white fw-semibold">💾 Gambar ke Local Storage → tabel <code>produk_local</code></div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="mb-2">
                            <label for="namaProduk" class="form-label fw-semibold">Nama produk</label>
                            <input type="text" class="form-control" id="namaProduk" name="namaProduk" maxlength="100" required />
                        </div>
                        <div class="mb-2">
                            <label for="harga" class="form-label fw-semibold">Harga (Rp)</label>
                            <input type="number" class="form-control" id="harga" name="harga" min="0" step="1000" required />
                        </div>
                        <div class="mb-3">
                            <label for="gambar" class="form-label fw-semibold">Gambar produk</label>
                            <input type="file" class="form-control" id="gambar" name="gambar" accept="image/jpeg,image/png,image/gif,image/webp,image/avif" required />
                            <div class="form-text">JPG, PNG, GIF, WebP, AVIF — maksimal 50 MB. Disimpan ke <code>wwwroot/uploads/produk/</code>.</div>
                        </div>

                        <button type="submit" class="btn btn-primary">💾 Simpan (local storage)</button>
                    </div>
                </form>
            </div>

            <!-- ==================== Form 2: R2 langsung dari browser ==================== -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold">☁️ Gambar ke R2 (langsung dari browser) → tabel <code>produk_r2</code></div>
                    <div class="card-body">
                        @if (!r2Configured)
                        {
                            <div class="alert alert-warning mb-0">
                                Konfigurasi R2 belum lengkap — isi <code>R2:*</code> dulu (lihat halaman
                                <a asp-controller="Upload" asp-action="R2">Upload R2</a>).
                            </div>
                        }
                        else
                        {
                            <form id="r2-form">
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <label for="nama-r2" class="form-label fw-semibold">Nama produk</label>
                                    <input type="text" class="form-control" id="nama-r2" maxlength="100" required />
                                </div>
                                <div class="mb-2">
                                    <label for="harga-r2" class="form-label fw-semibold">Harga (Rp)</label>
                                    <input type="number" class="form-control" id="harga-r2" min="0" step="1000" required />
                                </div>
                                <div class="mb-2">
                                    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Klik atau seret gambar ke sini">
                                        <input type="file" id="file-r2" hidden accept="image/jpeg,image/png,image/gif,image/webp,image/avif" />
                                        <div id="dropzone-empty">
                                            🖼️ <strong>Klik untuk memilih gambar</strong> atau seret di sini<br />
                                            <small class="text-muted">JPG, PNG, GIF, WebP, AVIF — maksimal 10 MB</small>
                                        </div>
                                        <img id="preview" alt="Preview gambar" class="preview-img" hidden />
                                    </div>
                                    <div id="file-meta" class="small text-muted mt-1" hidden></div>
                                </div>

                                <div id="progress-wrap" class="progress mb-2" style="height: 20px;" hidden>
                                    <div id="progress-bar" class="progress-bar progress-bar-striped" role="progressbar" style="width: 0%">0%</div>
                                </div>

                                <div id="error-box" class="alert alert-danger py-2" hidden></div>

                                <button type="submit" id="btn-upload" class="btn btn-primary" disabled>☁️ Upload ke R2 &amp; simpan</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== Daftar produk ==================== -->
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold">💾 produk_local (@produkLocal.Count)</div>
                    <div class="card-body p-0">
                        @if (produkLocal.Count == 0)
                        {
                            <p class="text-muted m-3 mb-0">Belum ada produk.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:64px"></th>
                                            <th>Nama</th>
                                            <th>Harga</th>
                                            <th>Ukuran</th>
                                            <th>Tanggal</th>
                                            <th style="width:90px">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in produkLocal)
                                        {
                                            <tr>
                                                <td><img src="@p.ImageUrl" alt="@p.NamaProduk" class="thumb" loading="lazy" /></td>
                                                <td>
                                                    <a href="@p.ImageUrl" target="_blank" rel="noopener" class="fw-semibold">@p.NamaProduk</a>
                                                    <div class="small text-muted text-break">@p.FileName</div>
                                                </td>
                                                <td>Rp @p.Harga.ToString("N0")</td>
                                                <td>@FileItemViewModel.FormatSize(p.UkuranByte)</td>
                                                <td class="small">@p.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                                <td>
                                                    <form asp-action="DeleteLocal" asp-route-id="@p.Id" method="post"
                                                          onsubmit="return confirm('Hapus produk ini beserta file gambarnya?')">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Hapus</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold">☁️ produk_r2 (@produkR2.Count)</div>
                    <div class="card-body p-0">
                        @if (produkR2.Count == 0)
                        {
                            <p class="text-muted m-3 mb-0">Belum ada produk.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:64px"></th>
                                            <th>Nama</th>
                                            <th>Harga</th>
                                            <th>Ukuran</th>
                                            <th>Tanggal</th>
                                            <th style="width:90px">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in produkR2)
                                        {
                                            <tr>
                                                <td>
                                                    @if (p.ImageUrl != null)
                                                    {
                                                        <a href="@p.ImageUrl" target="_blank" rel="noopener"><img src="@p.ImageUrl" alt="@p.NamaProduk" class="thumb" loading="lazy" /></a>
                                                    }
                                                    else
                                                    {
                                                        <span class="d-inline-block thumb"></span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">@p.NamaProduk</span>
                                                    <div class="small text-muted text-break">@p.ObjectKey</div>
                                                </td>
                                                <td>Rp @p.Harga.ToString("N0")</td>
                                                <td>@FileItemViewModel.FormatSize(p.UkuranByte)</td>
                                                <td class="small">@p.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                                <td>
                                                    <form asp-action="DeleteR2" asp-route-id="@p.Id" method="post"
                                                          onsubmit="return confirm('Hapus produk ini beserta object gambarnya di R2?')">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Hapus</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const MAX_BYTES = @(10 * 1024 * 1024);

            const form = document.getElementById('r2-form');
            if (!form) return;

            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const input = document.getElementById('file-r2');
            const dropzone = document.getElementById('dropzone');
            const dropzoneEmpty = document.getElementById('dropzone-empty');
            const preview = document.getElementById('preview');
            const fileMeta = document.getElementById('file-meta');
            const progressWrap = document.getElementById('progress-wrap');
            const progressBar = document.getElementById('progress-bar');
            const errorBox = document.getElementById('error-box');
            const btn = document.getElementById('btn-upload');

            let selectedFile = null;

            const ALLOWED_EXT = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif'];
            const startsWith = (bytes, signature) => signature.every((b, i) => bytes[i] === b);

            function readMagicBytes(file) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(new Uint8Array(reader.result));
                    reader.onerror = () => reject(new Error('Gagal membaca file.'));
                    reader.readAsArrayBuffer(file.slice(0, 16));
                });
            }

            async function validateImage(file) {
                const ext = file.name.split('.').pop().toLowerCase();
                if (!ALLOWED_EXT.includes(ext)) return `Ekstensi .${ext} tidak diizinkan.`;
                if (file.size <= 0) return 'File kosong.';
                if (file.size > MAX_BYTES) return 'Ukuran maksimal 10 MB.';

                const bytes = await readMagicBytes(file);
                if (startsWith(bytes, [0xFF, 0xD8, 0xFF])) return null;                                    // JPEG
                if (startsWith(bytes, [0x89, 0x50, 0x4E, 0x47])) return null;                              // PNG
                if (startsWith(bytes, [0x47, 0x49, 0x46, 0x38])) return null;                              // GIF8
                if (startsWith(bytes, [0x52, 0x49, 0x46, 0x46]) &&
                    startsWith(bytes.slice(8), [0x57, 0x45, 0x42, 0x50])) return null;                     // WebP
                if (startsWith(bytes, [0x66, 0x74, 0x79, 0x70])) {                                         // ISO-BMFF "ftyp"
                    const brand = String.fromCharCode(...bytes.slice(8, 12)).toLowerCase();
                    if (brand.startsWith('av')) return null;                                               // AVIF / AVIS
                }
                return 'Isi file tidak dikenali sebagai gambar yang diizinkan.';
            }

            async function selectFile(file) {
                showError(null);
                if (!file) return;

                const validationError = await validateImage(file);
                if (validationError) {
                    showError(validationError);
                    clearFile();
                    return;
                }

                selectedFile = file;
                preview.src = URL.createObjectURL(file);
                preview.hidden = false;
                dropzoneEmpty.hidden = true;
                fileMeta.textContent = `${file.name} • ${formatSize(file.size)}`;
                fileMeta.hidden = false;
                btn.disabled = false;
            }

            function clearFile() {
                selectedFile = null;
                input.value = '';
                preview.hidden = true;
                preview.removeAttribute('src');
                dropzoneEmpty.hidden = false;
                fileMeta.hidden = true;
                btn.disabled = true;
            }

            dropzone.addEventListener('click', () => input.click());
            dropzone.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
            });
            input.addEventListener('change', () => selectFile(input.files[0]));

            ['dragenter', 'dragover'].forEach((type) =>
                dropzone.addEventListener(type, (e) => { e.preventDefault(); dropzone.classList.add('dragover'); }));
            ['dragleave', 'drop'].forEach((type) =>
                dropzone.addEventListener(type, (e) => { e.preventDefault(); dropzone.classList.remove('dragover'); }));
            dropzone.addEventListener('drop', (e) => selectFile(e.dataTransfer.files[0]));

            // 1) Minta presigned URL ke backend (file tidak lewat backend).
            async function getPresignedUrl(file) {
                const res = await fetch('@Url.Action("PresignDirect", "Upload")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput.value,
                    },
                    body: JSON.stringify({ fileName: file.name, size: file.size }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.error || `Gagal minta presigned URL (HTTP ${res.status}).`);
                return data;
            }

            // 2) PUT gambar langsung ke R2 (XHR agar bisa menampilkan progress).
            function uploadToR2(url, contentType, file) {
                return new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    xhr.open('PUT', url);
                    xhr.setRequestHeader('Content-Type', contentType);
                    xhr.upload.addEventListener('progress', (e) => {
                        if (e.lengthComputable) {
                            const percent = Math.round((e.loaded / e.total) * 100);
                            progressBar.style.width = percent + '%';
                            progressBar.textContent = percent + '%';
                        }
                    });
                    xhr.addEventListener('load', () =>
                        xhr.status >= 200 && xhr.status < 300 ? resolve() : reject(new Error(`R2 menolak upload (HTTP ${xhr.status}).`)));
                    xhr.addEventListener('error', () =>
                        reject(new Error('Koneksi ke R2 gagal. Pastikan CORS bucket sudah diisi (lihat halaman Upload Direct FE).')));
                    xhr.addEventListener('abort', () => reject(new Error('Upload dibatalkan.')));
                    xhr.send(file);
                });
            }

            // 3) Rekam produk ke PostgreSQL lewat backend.
            async function simpanProduk(presign, file) {
                const res = await fetch('@Url.Action("R2", "Produk")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput.value,
                    },
                    body: JSON.stringify({
                        namaProduk: document.getElementById('nama-r2').value,
                        harga: parseFloat(document.getElementById('harga-r2').value),
                        objectKey: presign.key,
                        ukuranByte: file.size,
                        contentType: presign.contentType,
                    }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.error || `Gagal menyimpan produk (HTTP ${res.status}).`);
            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (!selectedFile || btn.disabled) return;

                showError(null);
                progressBar.style.width = '0%';
                progressBar.textContent = '0%';
                progressWrap.hidden = false;
                progressBar.classList.add('progress-bar-animated');
                btn.disabled = true;

                try {
                    const presign = await getPresignedUrl(selectedFile);
                    await uploadToR2(presign.url, presign.contentType, selectedFile);
                    await simpanProduk(presign, selectedFile);
                    // PRG: muat ulang agar tabel produk_r2 terbaru tampil.
                    location.href = '@Url.Action("Index", "Produk", new { saved = "r2" })';
                    return;
                } catch (err) {
                    showError(err.message);
                } finally {
                    progressWrap.hidden = true;
                    progressBar.classList.remove('progress-bar-animated');
                    if (selectedFile) btn.disabled = false;
                }
            });

            function showError(message) {
                errorBox.hidden = message === null;
                errorBox.textContent = message ?? '';
            }

            function formatSize(bytes) {
                if (bytes >= 1048576) return (bytes / 1048576).toFixed(2) + ' MB';
                if (bytes >= 1024) return (bytes / 1024).toFixed(2) + ' KB';
                return bytes + ' B';
            }
        })();
    </script>
}
