@{
    ViewData["Title"] = "Upload ke wwwroot";
    var files = (List<FileItemViewModel>)ViewBag.WwwrootFiles;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h1 class="h3 mb-1">📁 Upload File ke wwwroot</h1>
        <p class="text-muted mb-4">Sample upload file ke folder <code>wwwroot/uploads</code> di server aplikasi. File langsung bisa diakses sebagai static file.</p>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @if (ViewBag.UploadedUrl != null)
        {
            <div class="alert alert-success">
                <strong>✅ Upload berhasil!</strong>
                Tersimpan sebagai <code>@ViewBag.UploadedName</code>
                <span class="badge text-bg-secondary ms-1">@ViewBag.UploadedSizeText</span><br />
                <a href="@ViewBag.UploadedUrl" target="_blank" rel="noopener">Buka file →</a>
            </div>
        }

        <form asp-action="Wwwroot" method="post" enctype="multipart/form-data" class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label for="file" class="form-label fw-semibold">Pilih file</label>
                    <input type="file" class="form-control" id="file" name="file" required />
                    <div class="form-text">Nama file otomatis diberi prefix GUID untuk mencegah tabrakan nama. Maksimal 100 MB.</div>
                </div>
                <button type="submit" class="btn btn-primary">
                    ⬆️ Upload ke wwwroot
                </button>
            </div>
        </form>

        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">📄 File di wwwroot/uploads (@files.Count)</div>
            <div class="card-body p-0">
                @if (files.Count == 0)
                {
                    <p class="text-muted m-3 mb-0">Belum ada file terupload.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Nama File</th>
                                    <th style="width:110px">Ukuran</th>
                                    <th style="width:180px">Terakhir Diubah</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in files)
                                {
                                    <tr>
                                        <td class="text-break">
                                            <a href="@f.Url" target="_blank" rel="noopener">@f.Name</a>
                                        </td>
                                        <td>@f.SizeText</td>
                                        <td>@f.LastModified.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
